# Configuration for Integration / E2E Testing
# Bắt buộc trỏ vào CSDL kiểm thử riêng biệt (brewlite_test), tuyệt đối không dùng CSDL phát triển (brewlite)
TEST_DATABASE_URL=postgresql://brew:brew@localhost:5432/brewlite_test
DATABASE_URL=postgresql://brew:brew@localhost:5432/brewlite_test
DEV_DATABASE_URL=postgresql://brew:brew@localhost:5432/brewlite
JWT_SECRET=brewlite-isolated-test-jwt-secret-key-12345
CORS_ORIGIN=http://localhost:3000
PORT=3001
NODE_ENV=test
